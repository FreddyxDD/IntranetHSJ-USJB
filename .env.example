APP_NAME="Intranet HSJ - Citas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://intranethsj.test
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base propia del módulo. En desarrollo local se usa autenticación integrada.
DB_CONNECTION=sqlsrv
DB_HOST='localhost\SQLEXPRESS'
DB_PORT=
DB_DATABASE=Intranet_HSJ
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Usuarios, roles y permisos compartidos con el Portal de Citas.
IDENTITY_DB_HOST='localhost\SQLEXPRESS'
IDENTITY_DB_PORT=
IDENTITY_DB_DATABASE=HSJ_Identity
IDENTITY_DB_USERNAME=
IDENTITY_DB_PASSWORD=
IDENTITY_DB_TRUST_SERVER_CERTIFICATE=true
ACCESS_APPLICATION=intranet_hsj

# Fuente clínica de solo lectura salvo cambios de estado autorizados.
SIGH_DB_HOST=sigh.internal.example
SIGH_DB_PORT=
SIGH_DB_DATABASE=SIGH
SIGH_DB_USERNAME=
SIGH_DB_PASSWORD=
SIGH_DB_TRUST_SERVER_CERTIFICATE=true
SIGH_ALLOW_WRITES=false
SIGH_LOCAL_DB_HOST='localhost\SQLEXPRESS'
SIGH_LOCAL_DB_PORT=
SIGH_LOCAL_DB_DATABASE=SIGH_202607_LOCAL
SIGH_LOCAL_DB_USERNAME=
SIGH_LOCAL_DB_PASSWORD=
SIGH_LOCAL_DB_TRUST_SERVER_CERTIFICATE=true
EGRESOS_PATIENT_CONNECTION=sigh_local
EGRESOS_PATIENT_SOURCE_CODE=sigh_202607_local

MODULES_DB_HOST=127.0.0.1
MODULES_DB_PORT=3306
MODULES_DB_DATABASE=hospital_ueei
MODULES_DB_USERNAME=
MODULES_DB_PASSWORD=

MODULES_DB_HOST=127.0.0.1
MODULES_DB_PORT=3306
MODULES_DB_DATABASE=hospital_ueei
MODULES_DB_USERNAME=
MODULES_DB_PASSWORD=

APPOINTMENTS_DB_HOST=127.0.0.1
APPOINTMENTS_DB_PORT=3306
APPOINTMENTS_DB_DATABASE=citas
APPOINTMENTS_DB_USERNAME=
APPOINTMENTS_DB_PASSWORD=

APPOINTMENTS_DB_HOST=127.0.0.1
APPOINTMENTS_DB_PORT=3306
APPOINTMENTS_DB_DATABASE=citas
APPOINTMENTS_DB_USERNAME=
APPOINTMENTS_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="citas@hsj.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
